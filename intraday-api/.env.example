# Serveur API
PORT=3000
NODE_ENV=development

# Base de données SQLite
DATABASE_PATH=./data/intraday.db

# Paramètres Portefeuille & Trading
INITIAL_CAPITAL=1000
RISK_PER_TRADE_PERCENT=0.01
MAX_POSITION_UNITS=1000
MAX_SL_PERCENT=0.03
SCORE_ENTRY_THRESHOLD=70

# Horaires de Trading (EST)
MARKET_OPEN_EST=09:30
SQUARE_OFF_EST=15:45
MARKET_CLOSE_EST=16:00

# Paramètres Cron (Fuseau horaire America/New_York)
ENABLE_CRON=true
CRON_1M_SCHEDULE=* 9-15 * * 1-5
CRON_HOTLIST_SCHEDULE=15 9 * * 1-5

# Identifiants Trading 212
KEY_T212=your_trading212_api_key_here
SECRET_T212=your_trading212_api_secret_here
